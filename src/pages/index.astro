---
/**
 * Home page: "Brand Dial". The logo's orange, magenta and blue arcs turn
 * around a circular photo of each ride type. Uses its own header and footer
 * (Base `bare` mode). Hero photos other than the first load after the page.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import ThemeToggle from '../components/ThemeToggle.astro';
import expeditions from '../data/expeditions.json';

const all = await getCollection('stories', ({ data }) => !data.draft);
const bySlug = (slug: string) => all.find((s) => (s.data.slug || s.id) === slug);
const href = (slug: string) => `/${slug}/`;

const rides = [
  { name: 'Group rides', text: 'Every morning around Udaipur, at your pace.', img: '/home/group.webp', alt: 'Riders on a hill road at sunrise', color: '#f7941d', href: '/events/', x: 12, y: 12 },
  { name: 'Brevets', text: 'Long-distance rides through the night and into the dawn.', img: '/home/brm.webp', alt: 'Riders at dawn before a brevet', color: '#ec008c', href: href('udaipurs-inaugural-brm-event-concluded-with-flying-colors'), x: 88, y: 12 },
  { name: 'Expeditions', text: 'From the Thar to the Himalaya.', img: '/home/sach36.webp', alt: 'Switchback road climbing to Sach Pass', color: '#00aeef', href: '/signature-cycling-expedition/', x: 88, y: 88 },
  { name: 'Community', text: 'Cyclothons, club events and workshops.', img: '/home/earth.webp', alt: 'Club members together at the Earth Hour Cyclothon', color: '#22a84a', href: '/photos/', x: 12, y: 88 },
];

const stories = [
  { slug: 'ucc-shivani-nalwaya-udaipurs-first-female-ironman-70-3-finisher', tag: 'Milestone · Nov 2025', title: 'Udaipur’s youngest woman Ironman 70.3 finisher', img: '/home/shivani.webp', alt: 'Shivani Nalwaya at the finish', color: '#f7941d' },
  { slug: 'ucc-417-km-cycle-ride-udaipur-salangpur-balaji', tag: 'Ride diary · Feb 2026', title: 'Udaipur to Salangpur Balaji', img: '/home/balaji.webp', alt: 'Riders with the Indian flag after the Salangpur ride', color: '#ec008c' },
  { slug: 'a-bicycling-journey-from-manali-through-leh-to-khardungla', tag: 'Expedition · 2019', title: 'Manali to Leh to Khardung La', img: '/home/leh.webp', alt: 'UCC riders with a club banner in Leh', color: '#00aeef' },
  { slug: 'meet-sharad-jain-the-cyclist-who-pedaled-his-way-to-50000-km', tag: 'Milestone · 2023', title: 'Meet Sharad Jain', img: '/home/sharad.webp', alt: 'Sharad Jain', color: '#22a84a' },
].filter((s) => bySlug(s.slug));

const navLinks = [
  { label: 'Stories', href: '/blogs/' },
  { label: 'Expeditions', href: '/signature-cycling-expedition/' },
  { label: 'Events', href: '/events/' },
  { label: 'Challenges', href: '/ucc-challenges/' },
  { label: 'Photos', href: '/photos/' },
  { label: 'About', href: '/about/' },
];

const footerLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Stories', href: '/blogs/' },
  { label: 'Events', href: '/events/' },
  { label: 'Challenges', href: '/ucc-challenges/' },
  { label: 'Photos', href: '/photos/' },
  { label: 'Code of Conduct', href: '/ucc-code-of-conduct/' },
  { label: 'Rules', href: '/udaipurcyclingclub-rules-guidelines/' },
  { label: 'Privacy', href: '/privacy-policy/' },
  { label: 'Contact', href: '/contact/' },
];
---
<Base bare>
  <div class="dial-home">
    <div class="nav-wrap">
      <header class="bar">
        <a href="/" aria-label={`${site.name} home`} class="brand">
          <img src="/home/logo.webp" alt="" width="320" height="233" class="logo logo-for-light" />
          <img src="/home/logod.webp" alt="" width="320" height="233" class="logo logo-for-dark" />
        </a>
        <nav class="links" aria-label="Primary">{navLinks.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
        <div class="acts">
          <ThemeToggle />
          <a class="login" href={site.appUrl} target="_blank" rel="noopener">Login</a>
        </div>
      </header>
      <nav class="links-phone" aria-label="Sections">{navLinks.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    </div>

    <main>
      <section id="ride" class="hero" data-dial>
        <div class="copy">
          <span class="kicker">{site.name} · since {site.founded}</span>
          <h1>Ride above <em>it&nbsp;all.</em></h1>
          <p class="lead">From the lakes of Udaipur to the passes of the Himalaya. A club that rides together, every morning.</p>
          <div class="ride-now" aria-live="polite">
            <a href={rides[0].href} class="ride-name" data-ride-link>{rides[0].name}</a>
            <p data-ride-text>{rides[0].text}</p>
          </div>
        </div>

        <div class="dial">
          <svg viewBox="0 0 620 620" aria-hidden="true">
            <circle class="r1" cx="310" cy="310" r="298" pathLength="100" stroke-dasharray="62 100" stroke="#00aeef" />
            <circle class="r2" cx="310" cy="310" r="271" pathLength="100" stroke-dasharray="55 100" stroke="#ec008c" />
            <circle class="r3" cx="310" cy="310" r="244" pathLength="100" stroke-dasharray="48 100" stroke="#f7941d" />
          </svg>
          <div class="photo">
            {rides.map((r, i) => (
              i === 0
                ? <img class="on" data-photo="0" src={r.img} alt={r.alt} width="900" height="675" fetchpriority="high" decoding="async" />
                : <img data-photo={i} data-src={r.img} alt={r.alt} width="900" height="675" decoding="async" />
            ))}
          </div>
          {rides.map((r, i) => (
            <button
              type="button"
              class:list={['tag', { on: i === 0 }]}
              style={`left:${r.x}%;top:${r.y}%;--c:${r.color}`}
              data-tag={i}
              data-name={r.name}
              data-text={r.text}
              data-href={r.href}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >{r.name}</button>
          ))}
        </div>
      </section>

      <section id="stories" class="wrap sec">
        <div class="head">
          <h2>Rider <em>stories</em></h2>
          <a href="/blogs/" class="more">All stories</a>
        </div>
        <div class="circles">
          {stories.map((s) => (
            <a href={href(s.slug)} class="circle" style={`--c:${s.color}`}>
              <div class="im"><img src={s.img} alt={s.alt} width="900" height="900" loading="lazy" decoding="async" /></div>
              <span class="kicker small">{s.tag}</span>
              <span class="title">{s.title}</span>
            </a>
          ))}
        </div>
      </section>

      <section id="expeditions" class="sec">
        <div class="wrap head">
          <h2>Signature <em>expeditions</em></h2>
          <a href="/signature-cycling-expedition/" class="more">All expeditions</a>
        </div>
        <div class="marquee">
          <div class="track">
            {[0, 1].map((n) => expeditions.map((e) => (
              <div class="badge" aria-hidden={n === 1 ? 'true' : undefined}>
                <img src={e.src} alt={n === 1 ? '' : `${e.title} badge`} width="190" height="150" loading="lazy" decoding="async" />
              </div>
            )))}
          </div>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <div class="foot-top">
        <img src="/home/logo.webp" alt={site.name} width="320" height="233" class="foot-logo logo-for-light" loading="lazy" />
        <img src="/home/logod.webp" alt={site.name} width="320" height="233" class="foot-logo logo-for-dark" loading="lazy" />
        <nav aria-label="Footer" class="foot-links">{footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
        <ThemeToggle showLabel />
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="foot-contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={site.social.youtube} target="_blank" rel="noopener">YouTube</a>
          <a href={site.appUrl} target="_blank" rel="noopener">UCC app</a>
        </span>
      </div>
    </footer>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-dial]');
  if (root) {
    const photos = [...root.querySelectorAll<HTMLImageElement>('[data-photo]')];
    const tags = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const link = root.querySelector<HTMLAnchorElement>('[data-ride-link]')!;
    const text = root.querySelector<HTMLElement>('[data-ride-text]')!;
    let current = 0;
    let timer: number | undefined;

    const load = (img: HTMLImageElement) => {
      if (img.dataset.src && !img.getAttribute('src')) img.src = img.dataset.src;
    };
    const show = (i: number) => {
      current = i;
      load(photos[i]);
      photos.forEach((p, n) => p.classList.toggle('on', n === i));
      tags.forEach((t, n) => {
        t.classList.toggle('on', n === i);
        t.setAttribute('aria-pressed', String(n === i));
      });
      const t = tags[i];
      link.textContent = t.dataset.name!;
      link.href = t.dataset.href!;
      text.textContent = t.dataset.text!;
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };

    tags.forEach((t, i) => t.addEventListener('click', () => { stop(); show(i); }));

    // The remaining hero photos wait until the page has finished loading.
    const later = () => setTimeout(() => photos.forEach(load), 400);
    if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => {
        if (!document.hidden) show((current + 1) % photos.length);
      }, 6000);
    }
  }
</script>

<style>
  :global(body.bare) { background: var(--bg); color: var(--ink); }
  .dial-home { font-family: 'Onest', system-ui, sans-serif; color: var(--ink); background: var(--bg); overflow: clip; }
  .dial-home h1, .dial-home h2 { font-family: 'Onest', system-ui, sans-serif; font-weight: 600; letter-spacing: -.045em; margin: 0; color: var(--ink); }
  .dial-home em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -.02em; }
  .dial-home img { max-width: 100%; }
  .wrap { max-width: 1360px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
  .sec { padding-top: 112px; }
  .kicker { font-size: 18px; font-weight: 600; color: var(--brand-text); }
  .kicker.small { font-size: 14px; }

  .nav-wrap { position: sticky; top: 12px; z-index: 30; padding: 12px 24px 0; }
  .bar { max-width: 1360px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 8px 6px 16px; border-radius: 999px; background: var(--bar-bg, rgba(255,255,255,.82)); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 8px 28px rgba(18,22,28,.1); }
  :global([data-theme='dark']) .bar { --bar-bg: rgba(23,27,33,.82); }
  .brand { flex: 0 0 auto; }
  .logo { height: 42px; width: auto; }
  .links { display: flex; gap: 2px; font-size: 15px; font-weight: 500; }
  .links a, .links-phone a { min-height: 44px; display: flex; align-items: center; padding: 0 12px; border-radius: 999px; }
  .links-phone { display: none; }
  .acts { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
  .login { min-height: 48px; padding: 0 20px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--orange); color: var(--on-brand); font-weight: 600; font-size: 15px; }
  .login:hover { color: var(--on-brand); }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 30px; align-items: center; padding: 60px 28px 0; max-width: 1360px; margin: 0 auto; }
  .copy { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .hero h1 { font-size: clamp(60px, 8.6vw, 134px); line-height: .9; }
  .lead { margin: 0; font-size: 21px; line-height: 1.4; max-width: 470px; color: var(--dim); }
  .ride-now { padding-top: 12px; min-height: 96px; }
  .ride-now p { margin: 0; color: var(--dim); }
  .ride-name { font-size: 26px; font-weight: 600; letter-spacing: -.02em; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }

  .dial { position: relative; width: 100%; max-width: 660px; aspect-ratio: 1; margin: 0 auto; }
  .dial svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dial circle { fill: none; stroke-width: 15; stroke-linecap: round; transform-origin: 310px 310px; animation: spin 38s linear infinite; }
  .dial .r2 { animation-duration: 52s; animation-direction: reverse; }
  .dial .r3 { animation-duration: 30s; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .photo { position: absolute; inset: 16.5%; border-radius: 50%; overflow: hidden; background: var(--card); }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .7s ease; }
  .photo img.on { opacity: 1; }
  .tag { position: absolute; transform: translate(-50%, -50%); min-height: 46px; padding: 0 18px; display: flex; align-items: center; border: 0; border-radius: 999px; background: var(--tag-bg, #fff); color: var(--ink); font: 600 16px 'Onest', system-ui, sans-serif; cursor: pointer; white-space: nowrap; box-shadow: 0 8px 24px rgba(18,22,28,.13); transition: transform .25s, background-color .25s, color .25s; }
  :global([data-theme='dark']) .tag { --tag-bg: #171b21; }
  .tag.on { background: var(--c); color: #12161c; transform: translate(-50%, -50%) scale(1.1); }
  .tag:focus-visible, .bar a:focus-visible { outline: 2px solid var(--brand-text); outline-offset: 2px; }

  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 30px; }
  .head h2 { font-size: clamp(38px, 5.2vw, 76px); line-height: 1; }
  .more { display: inline-flex; align-items: center; min-height: 46px; padding: 0 18px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); font-weight: 600; font-size: 15px; }

  .circles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .circle { display: flex; flex-direction: column; gap: 12px; text-align: center; align-items: center; color: inherit; }
  .circle:hover { color: inherit; }
  .circle .im { width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 5px var(--bg), 0 0 0 9px var(--c); transition: border-radius .4s; }
  .circle:hover .im { border-radius: 30px; }
  .circle .im img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .circle .title { font-size: 21px; font-weight: 600; line-height: 1.2; letter-spacing: -.02em; }

  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; gap: 12px; width: max-content; animation: slide 46s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .badge { width: 190px; height: 150px; flex: none; background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 14px; }
  .badge img { width: 100%; height: 100%; object-fit: contain; }

  .foot { margin-top: 112px; padding-top: 32px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 24px; border-top: 1px solid var(--line); }
  .foot-top { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .foot-logo { height: 40px; width: auto; }
  .foot-links { display: flex; gap: 6px 22px; flex-wrap: wrap; font-size: 15px; color: var(--dim); }
  .foot-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 14px; color: var(--dim); }
  .foot-contact { display: flex; gap: 16px; flex-wrap: wrap; }

  @media (max-width: 1040px) {
    .links { display: none; }
    .links-phone { display: flex; gap: 2px; margin-top: 6px; padding: 2px 4px; overflow-x: auto; scrollbar-width: none; font-size: 15px; font-weight: 500; background: var(--bg); border-radius: 14px; }
    .links-phone a { flex: none; }
  }
  @media (max-width: 860px) {
    .wrap { padding-left: 16px; padding-right: 16px; }
    .sec { padding-top: 72px; }
    .nav-wrap { padding: 8px 10px 0; }
    .hero { grid-template-columns: 1fr; padding: 26px 16px 0; gap: 14px; }
    .tag { font-size: 14px; padding: 0 13px; }
    .circles { grid-template-columns: 1fr 1fr; gap: 14px; }
    .circle .title { font-size: 17px; }
    .foot { margin-top: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dial circle, .track { animation: none; }
    .marquee { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
    .photo img, .tag { transition: none; }
  }
</style>
