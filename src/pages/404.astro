---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="container" style="text-align:center">
      <span class="eyebrow">404</span>
      <h1>Flat tyre. This page doesn't exist.</h1>
      <p class="lead" style="margin:0 auto 24px">The link may be old or mistyped. Try one of these instead.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/blogs/" class="btn btn-outline">Stories</a>
        <a href="/contact/" class="btn btn-outline">Contact</a>
      </div>
    </div>
  </section>
</Base>
