---
/**
 * Serves both stories and static pages at /<slug>/ — the same URLs the old
 * WordPress site used, so nothing needs redirecting.
 */
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../data/site';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  const pages = await getCollection('pages');
  const sorted = [...stories].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return [
    ...sorted.map((entry, i) => ({
      params: { slug: entry.data.slug || entry.id },
      props: { kind: 'story', entry, related: sorted.filter((_, j) => j !== i).slice(0, 3) },
    })),
    ...pages.map((entry) => ({ params: { slug: entry.data.slug || entry.id }, props: { kind: 'page', entry, related: [] } })),
  ];
}

const { kind, entry, related } = Astro.props;
const isStory = kind === 'story';
const d = entry.data as any;
const Content = d.html ? null : (await render(entry)).Content;
// Imported WordPress HTML keeps its /uploads/ URLs untouched; we only add lazy
// loading so gallery-heavy stories don't fetch every image up front.
const html = d.html
  ? d.html.replace(/<img\b(?![^>]*\bloading=)/g, '<img loading="lazy" decoding="async"')
  : null;
const dateStr = isStory ? d.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<Base
  title={d.title}
  description={isStory ? d.excerpt || site.description : d.description || `${d.title} – ${site.name}`}
  image={isStory ? d.cover : null}
  type={isStory ? 'article' : 'website'}
  publishedTime={isStory ? d.date : undefined}
>
  {isStory ? (
    <article>
      <header class="page-hero story-head">
        <div class="container narrow">
          <div class="meta">
            {d.categories.map((c: string) => <span class="chip chip-orange">{c}</span>)}
            <time datetime={d.date.toISOString()} class="muted">{dateStr}</time>
            <span class="muted">· {d.author}</span>
          </div>
          <h1>{d.title}</h1>
          {d.excerpt && <p class="lead">{d.excerpt}</p>}
        </div>
      </header>
      {d.cover && (
        <div class="container narrow">
          <img src={d.cover} alt={d.coverAlt || ''} class="cover" width="1200" height="675" />
        </div>
      )}
      <div class="container narrow">
        <div class="prose body">
          {html ? <Fragment set:html={html} /> : Content && <Content />}
        </div>
        <div class="share">
          <span class="muted">Share:</span>
          <a href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ' + shareUrl)}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener">Facebook</a>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(d.title)}`} target="_blank" rel="noopener">X</a>
        </div>
      </div>
      {related.length > 0 && (
        <section class="section section-alt">
          <div class="container">
            <span class="eyebrow">Keep reading</span>
            <h2>More stories</h2>
            <div class="grid grid-3">{related.map((s: any) => <StoryCard story={s} />)}</div>
          </div>
        </section>
      )}
    </article>
  ) : (
    <article>
      <header class="page-hero">
        <div class="container narrow">
          <h1>{d.title}</h1>
          {d.description && <p class="lead">{d.description}</p>}
        </div>
      </header>
      <div class="container narrow">
        <div class="prose body">
          {html ? <Fragment set:html={html} /> : Content && <Content />}
        </div>
      </div>
    </article>
  )}
</Base>

<style>
  .narrow { max-width: 820px; }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; font-size: 0.9rem; }
  .story-head h1 { font-size: clamp(1.8rem, 4.2vw, 2.8rem); }
  .cover { width: 100%; border-radius: 16px; margin: 28px 0 8px; object-fit: cover; max-height: 560px; }
  .body { padding: 24px 0 8px; max-width: none; }
  .share { display: flex; gap: 14px; align-items: center; border-top: 1px solid var(--line); margin-top: 32px; padding-top: 18px; font-weight: 600; }
  .share a:hover { color: var(--orange); }
</style>
