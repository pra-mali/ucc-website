---
import { site, nav, moreNav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="about">
        <img src="/logo-horizontal-ondark.png" alt={site.name} width="150" height="110" class="logo" />
        <p class="small">{site.description}</p>
        <div class="social">
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3v2.3H7.4V14h2.8v8h3.3z"/></svg>
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
          <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9l6 3.1-6 3.1z"/></svg>
          </a>
          <a href={site.social.twitter} target="_blank" rel="noopener" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.5 3h3l-7 8 8.2 10h-6.4l-5-6.6L4.6 21h-3l7.5-8.6L1.3 3h6.6l4.5 6 5.1-6zm-1.1 16.2h1.7L7 4.7H5.2l11.2 14.5z"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>Club</h4>
        <ul>{moreNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>Contact</h4>
        <address>
          {site.address.map((l) => <div>{l}</div>)}
          <div class="gap"><a href={`mailto:${site.email}`}>{site.email}</a></div>
          <div><a href={site.whatsapp} target="_blank" rel="noopener">{site.phone}</a> <span class="faint">({site.phoneNote})</span></div>
        </address>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>Founded {site.founded} · Udaipur, Rajasthan</span>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(48px, 8vw, 96px); padding: 48px 0 32px; border-top: 1px solid var(--line); color: var(--dim); font-size: 15px; }
  .cols { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1.4fr; gap: 32px; }
  .logo { height: 40px; width: auto; margin-bottom: 16px; }
  .small { font-size: 14px; line-height: 1.6; max-width: 42ch; }
  h4 { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.5rem; }
  a:hover { color: var(--ink); }
  address { font-style: normal; line-height: 1.65; }
  .gap { margin-top: 0.7rem; }
  .faint { color: rgba(255, 255, 255, 0.45); }
  .social { display: flex; gap: 8px; margin-top: 16px; }
  .social a { display: inline-flex; padding: 11px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12); }
  .social a:hover { background: var(--orange); border-color: var(--orange); color: #2b1100; }
  .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; border-top: 1px solid var(--line); margin-top: 40px; padding-top: 20px; font-size: 13px; color: rgba(255, 255, 255, 0.5); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .cols { grid-template-columns: 1fr; } }
</style>
