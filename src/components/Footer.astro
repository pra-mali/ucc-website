---
import { site, nav, moreNav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container cols">
    <div>
      <img src="/logo-horizontal-ondark.png" alt={site.name} width="150" height="110" class="logo" />
      <p class="muted small">{site.description}</p>
      <div class="social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3v2.3H7.4V14h2.8v8h3.3z"/></svg>
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9l6 3.1-6 3.1z"/></svg>
        </a>
        <a href={site.social.twitter} target="_blank" rel="noopener" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M17.5 3h3l-7 8 8.2 10h-6.4l-5-6.6L4.6 21h-3l7.5-8.6L1.3 3h6.6l4.5 6 5.1-6zm-1.1 16.2h1.7L7 4.7H5.2l11.2 14.5z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Club</h4>
      <ul>{moreNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Contact</h4>
      <address>
        {site.address.map((l) => <div>{l}</div>)}
        <div style="margin-top:.6rem"><a href={`mailto:${site.email}`}>{site.email}</a></div>
        <div><a href={site.whatsapp} target="_blank" rel="noopener">{site.phone}</a> <span class="muted">({site.phoneNote})</span></div>
      </address>
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} {site.name}. All rights reserved.</span>
    <span class="muted">Founded {site.founded} · Udaipur, Rajasthan</span>
  </div>
</footer>

<style>
  .footer { background: #111; color: #e8e8e8; margin-top: 64px; padding: 56px 0 24px; }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.3fr; gap: 32px; }
  .logo { height: 56px; width: auto; margin-bottom: 12px; }
  .small { font-size: 0.92rem; max-width: 40ch; }
  h4 { color: #fff; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.9rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.45rem; }
  a:hover { color: var(--orange); }
  address { font-style: normal; line-height: 1.6; font-size: 0.95rem; }
  .muted { color: #9a9a9a; }
  .social { display: flex; gap: 10px; margin-top: 12px; }
  .social a { display: inline-flex; padding: 8px; border-radius: 999px; background: #1f1f1f; }
  .social a:hover { background: var(--orange); color: #111; }
  .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid #262626; margin-top: 40px; padding-top: 20px; font-size: 0.88rem; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
</style>
