---
import { site, nav, moreNav } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img class="logo-for-light" src="/logo-horizontal.png" alt="" width="150" height="110" />
      <img class="logo-for-dark" src="/logo-horizontal-ondark.png" alt="" width="150" height="110" />
      <span class="visually-hidden">{site.name}</span>
    </a>
    <nav id="site-nav" class="nav glass" aria-label="Primary">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li class="more">
          <details>
            <summary>More</summary>
            <ul class="menu glass">
              {moreNav.map((n) => <li><a href={n.href} target={n.href.startsWith('http') ? '_blank' : undefined} rel={n.href.startsWith('http') ? 'noopener' : undefined}>{n.label}</a></li>)}
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    <div class="actions">
      <ThemeToggle />
      <button class="menu-btn glass" aria-expanded="false" aria-controls="site-nav" id="menu-btn">
        <span class="visually-hidden">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
  // Close the "More" menu when clicking elsewhere.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.site-header .more details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line-faint); }
  /* Blur lives on a pseudo-element so the menu panels inside can frost the page too. */
  .site-header::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, var(--header-from), var(--header-to));
    -webkit-backdrop-filter: blur(18px) saturate(160%); backdrop-filter: blur(18px) saturate(160%);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px var(--gutter); }
  .brand { flex: 0 0 auto; }
  .brand img { height: 40px; width: auto; }
  .nav { border-radius: 999px; padding: 6px; box-shadow: var(--glass-inset); }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 2px; }
  .nav a, .more summary { display: block; padding: 9px 15px; border-radius: 999px; font-weight: 500; font-size: 14px; line-height: 1.3; white-space: nowrap; }
  .nav a:hover, .more summary:hover { background: var(--fill-4); color: var(--ink); }
  .nav a[aria-current='page'] { background: var(--pill-on); color: var(--bg); }
  .more details { position: relative; }
  .more summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; }
  .more summary::after { content: ''; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); opacity: 0.7; }
  .more summary::-webkit-details-marker { display: none; }
  .more .menu {
    position: absolute; right: 0; top: calc(100% + 12px); min-width: 230px; flex-direction: column; align-items: stretch; gap: 2px;
    padding: 8px; border-radius: 22px; background: var(--menu-bg);
  }
  .more .menu a { padding: 10px 14px; border-radius: 14px; }
  .actions { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
  .join { padding: 12px 20px; border-radius: 999px; background: var(--ink); color: var(--bg); font-weight: 700; font-size: 14px; white-space: nowrap; }
  .join:hover { color: var(--bg); opacity: 0.88; }
  .menu-btn { display: none; width: 46px; height: 46px; align-items: center; justify-content: center; border-radius: 999px; color: var(--ink); cursor: pointer; padding: 0; box-shadow: var(--glass-inset); }

  @media (max-width: 1080px) {
    .menu-btn { display: inline-flex; }
    .nav {
      display: none; position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% + 8px);
      border-radius: 28px; padding: 10px; background: var(--menu-bg-solid);
      max-height: calc(100svh - 100px); overflow-y: auto;
    }
    .nav.open { display: block; }
    .nav ul { flex-direction: column; align-items: stretch; gap: 2px; }
    .nav a, .more summary { padding: 13px 16px; font-size: 16px; border-radius: 18px; }
    .more details[open] summary::after { transform: translateY(2px) rotate(-135deg); }
    .more .menu { position: static; background: none; border: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; padding: 0 0 0 12px; min-width: 0; }
  }
  @media (max-width: 420px) {
    .brand img { height: 34px; }
    .join { padding: 11px 14px; font-size: 13px; }
  }
</style>
