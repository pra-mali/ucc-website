---
/** Light/Dark Appearance control. Every instance on a page stays in sync. */
interface Props { showLabel?: boolean }
const { showLabel = false } = Astro.props;
---
<div class="appearance">
  {showLabel && <span class="label" aria-hidden="true">Appearance</span>}
  <div class="toggle" role="group" aria-label="Appearance" data-theme-toggle>
    <button type="button" data-theme-value="light" aria-pressed="true" aria-label="Light mode">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button type="button" data-theme-value="dark" aria-pressed="false" aria-label="Dark mode">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</div>

<script>
  const KEY = 'ucc-theme';
  const COLORS: Record<string, string> = { light: '#f3f5f4', dark: '#07090c' };

  const stored = () => {
    try { return localStorage.getItem(KEY) === 'dark' ? 'dark' : 'light'; } catch { return 'light'; }
  };
  const apply = (theme: string) => {
    document.documentElement.setAttribute('data-theme', theme);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', COLORS[theme]);
    document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.themeValue === theme)));
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) =>
    b.addEventListener('click', () => {
      const theme = b.dataset.themeValue!;
      try { localStorage.setItem(KEY, theme); } catch { /* storage blocked: applies to this page only */ }
      apply(theme);
    }));
  addEventListener('storage', (e) => { if (e.key === KEY) apply(stored()); });
  // Pages restored from the back/forward cache may hold an older choice.
  addEventListener('pageshow', () => apply(stored()));
  apply(stored());
</script>

<style>
  .appearance { display: inline-flex; align-items: center; gap: 10px; }
  .label { font-size: 13px; font-weight: 600; color: var(--dim); }
  .toggle {
    display: inline-flex; gap: 2px; padding: 2px; border-radius: 999px; flex: 0 0 auto;
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    box-shadow: 0 0 0 1px var(--line-faint);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  }
  button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; padding: 0; border: 0; border-radius: 999px;
    background: transparent; color: var(--dim); cursor: pointer; transition: background 0.15s, color 0.15s;
  }
  button:hover { background: var(--fill-4); color: var(--ink); }
  button:focus-visible { outline: 2px solid var(--brand-text); outline-offset: 1px; }
  /* Driven by <html data-theme> so a stored Dark shows correctly before any script runs. */
  :global(:root[data-theme='light']) [data-theme-value='light'],
  :global(:root[data-theme='dark']) [data-theme-value='dark'] { background: var(--orange); color: var(--on-brand); }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
