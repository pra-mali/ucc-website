---
import type { CollectionEntry } from 'astro:content';
interface Props { story: CollectionEntry<'stories'>; featured?: boolean }
const { story, featured = false } = Astro.props;
const { title, excerpt, cover, coverAlt, categories, date } = story.data;
const slug = story.data.slug || story.id;
const dateStr = date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const chip = (c: string) => /expedition/i.test(c) ? 'chip-sky' : /achievement|marathon/i.test(c) ? 'chip-magenta' : 'chip-orange';
---
<article class:list={['card', 'story', { featured }]}>
  <a href={`/${slug}/`} class="media" aria-hidden="true" tabindex="-1">
    {cover ? <img src={cover} alt={coverAlt || ''} loading="lazy" width="800" height="500" /> : <div class="placeholder"></div>}
  </a>
  <div class="body">
    <div class="meta">
      {categories.slice(0, 2).map((c) => <span class:list={['chip', chip(c)]}>{c}</span>)}
      <time datetime={date.toISOString()} class="muted">{dateStr}</time>
    </div>
    <h3><a href={`/${slug}/`}>{title}</a></h3>
    {excerpt && <p class="muted excerpt">{excerpt}</p>}
    <a href={`/${slug}/`} class="read">Read story</a>
  </div>
</article>

<style>
  .story { display: flex; flex-direction: column; gap: 4px; padding: 10px; transition: transform 0.25s, border-color 0.25s, background 0.25s; }
  .story:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.07); }
  .media { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 22px; background: var(--bg-2); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .story:hover .media img { transform: scale(1.04); }
  .placeholder { width: 100%; height: 100%; background: radial-gradient(circle at 30% 30%, rgba(247, 148, 29, 0.5), transparent 60%), #141820; }
  .body { padding: 12px 10px 12px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.85rem; }
  h3 { font-size: 1.3rem; line-height: 1.15; margin: 0; }
  .featured h3 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); }
  .excerpt { font-size: 0.95rem; line-height: 1.55; color: var(--dim); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin: 0; }
  .read { margin-top: auto; align-self: flex-start; padding: 9px 16px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.2); font-weight: 600; font-size: 0.88rem; }
  .read:hover { background: rgba(255, 255, 255, 0.08); color: var(--ink); }
  @media (min-width: 800px) { .featured { grid-column: span 2; } .featured .media { aspect-ratio: 21 / 9; } }
  @media (prefers-reduced-motion: reduce) { .story, .media img { transition: none; } }
</style>
