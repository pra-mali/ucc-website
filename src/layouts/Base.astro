---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organization, website, graph, ORG_ID, WEBSITE_ID } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Alt text for the share image. */
  imageAlt?: string;
  /** Page language (BCP 47), e.g. "hi" for Hindi stories. */
  lang?: string;
  /** schema.org type for the page node (WebPage, AboutPage, ContactPage, CollectionPage…). Ignored for articles. */
  pageType?: string;
  /** Extra JSON-LD nodes for this page (article, breadcrumbs, item lists…). */
  jsonLd?: unknown[];
  noindex?: boolean;
  /** Render without the standard header and footer (the home page has its own). */
  bare?: boolean;
}
const { title, description = site.description, image, type = 'website', publishedTime, modifiedTime, imageAlt, lang = "en", pageType = "WebPage", jsonLd = [], noindex = false, bare = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} - ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/uploads/SachPass_UdaipurCyclingClub-36.jpg', Astro.site);
const ogImageAlt = imageAlt || (image ? title || site.name : 'Switchback road to Sach Pass, ridden by Udaipur Cycling Club');
const pageNode = type === 'article' ? null : {
  '@type': pageType,
  '@id': canonical + '#webpage',
  url: canonical.toString(),
  name: title || site.name,
  description,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': ORG_ID },
  primaryImageOfPage: ogImage.toString(),
  inLanguage: lang,
};
const ld = noindex ? null : JSON.stringify(graph([organization(), website(), pageNode, ...jsonLd])).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="author" content={site.name} />
    <link rel="alternate" type="application/rss+xml" title={site.name + " stories"} href="/rss.xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#07090c" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === "hi" ? "hi_IN" : "en_IN"} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Udaipur_Cycling" />
    <meta name="twitter:title" content={title || site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=Noto+Sans+Devanagari:wght@400;700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={bare ? 'bare' : undefined}>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
